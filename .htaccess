# kenazorg.nl – Apache / Plesk
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Live domein: altijd https en zonder www.
#    Andere hosts (zoals de testomgeving new.kenazorg.nl) worden niet doorgestuurd.
RewriteCond %{HTTP_HOST} ^(www\.)?kenazorg\.nl$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://kenazorg.nl/$1 [R=301,L]

# 2. Interne bestanden blokkeren
RewriteRule ^api/_ - [F,L]
RewriteRule ^private(/|$) - [F,L]

# 3. Oude WordPress-URL's (de paginapaden zelf blijven gelijk)
RewriteRule ^homepagina-nieuw/?$ / [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^contact$ /contact/ [R=301,L]
RewriteRule ^(.*/)?feed/?$ / [R=301,L]
RewriteRule ^wp-content/uploads/2025/09/Aanmeldformulier-officiele-aanmelding_Kena-Zorg\.pdf$ /downloads/Aanmeldformulier-officiele-aanmelding_Kena-Zorg.pdf [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php)(/.*)?$ / [R=301,L]
RewriteRule ^wp-content/ / [R=301,L]

# 4. Trailing slash toevoegen als de map bestaat (/aanbod -> /aanbod/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Testomgeving niet laten indexeren door zoekmachines
SetEnvIfNoCase Host "^kenazorg\.nl$" LIVE_SITE
SetEnvIfNoCase Host "^www\.kenazorg\.nl$" LIVE_SITE

<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow" env=!LIVE_SITE
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000" env=LIVE_SITE
<FilesMatch "\.(html)$">
  Header set Cache-Control "public, max-age=300, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2|webp|png|jpg|svg|pdf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/webp .webp
</IfModule>
